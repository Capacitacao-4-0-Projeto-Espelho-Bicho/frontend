# Back-end usado pelo proxy do Vite em desenvolvimento (padrão: API no Render).
# Para um back-end local: VITE_API_ALVO=http://localhost:5000
VITE_API_ALVO=

# URL base para chamar a API direto (só para o front publicado fora do Vite;
# exige CORS no back-end). Vazio = mesma origem, via proxy.
VITE_API_BASE=
